# ── 로컬 Ollama 경로(권장 · API 키 불필요) ──
# macOS Ollama 앱/CLI에서 로그인 후 `ollama run glm-5.3-flash:cloud` 로 모델을 준비하세요.
WISE_LLM_BASE_URL=http://127.0.0.1:11434/v1
WISE_LLM_MODEL=glm-5.3-flash:cloud

# ── OpenAI 공식 경로(선택) ──
# 아래 두 줄의 주석을 풀고 발급 키를 입력하면 api.openai.com 으로 호출합니다.
# OPENAI_API_KEY=sk-...
# WISE_LLM_MODEL=gpt-5-mini
